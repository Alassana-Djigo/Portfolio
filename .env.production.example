# Copia para .env no servidor e preenche. NUNCA vás para o Git (o .env já está no .gitignore).
# Gerar a chave:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troca-isto-por-uma-chave-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=o-teu-dominio.dev,www.o-teu-dominio.dev
CSRF_TRUSTED_ORIGINS=https://o-teu-dominio.dev,https://www.o-teu-dominio.dev

# Caminho do painel de administração (escolhe algo que só tu saibas)
ADMIN_URL=troca-este-caminho-secreto/

# HSTS: começa em 1 hora. Quando tudo estiver estável, sobe para 31536000 (1 ano).
SECURE_HSTS_SECONDS=3600

# Email (opcional; deixa vazio para não enviar). Exemplo com Gmail + "palavra-passe de app":
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
